{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "stlink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/canpute.elf",
            "device": "STM32H533xx",
            "gdbPath": "${userHome}/.local/share/stm32cube/bundles/gnu-gdb-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gdb",
            "serverArgs": ["-m", "1", "-k"],
            "serverpath": "${userHome}/.local/share/stm32cube/bundles/stlink-gdbserver/7.14.0+st.2/bin/ST-LINK_gdbserver",
            "stm32cubeprogrammer": "${userHome}/.local/share/stm32cube/bundles/programmer/2.23.0/bin",
            "svdFile": "${userHome}/.local/share/stm32cube/packs/STMicroelectronics/stm32h5xx_dfp/1.2.0/SVD/STM32H533.svd",
            "runToEntryPoint": "main",
            "preLaunchTask": "CMake: build Debug"
        }
    ]
}